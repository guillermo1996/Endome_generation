# ── Pipeline variables ────────────────────────────────────────────────
input_dataset = config.get("input_dataset", ["Ebbert"])
input_group = config.get("input_group", ["control"])
merge_method = config.get("merge_preset", ["st_ref"])
pc_filter = config.get("orf_filter_preset", ["pc"])
trunc_site = config.get("trunc_site", ["3p"])
trunc_width = config.get("trunc_width", [500])
pseudobulk_method = config.get("pseudobulk_preset", ["default"])
saturn_method = config.get("saturn_preset", ["default"])

# ── Helper functions ──────────────────────────────────────────────────
def generate_param_files():
    """List the per-step ``parameters.yaml`` targets to request in ``rule all``.

    The files are always requested, so a missing one is written. Whether an
    existing one is *rewritten* on every invocation is decided by
    ``config["always_save_params"]`` (see ``create_save_params_rule``).
    """
    param_dict = {
        "step01_params": expand(step01.path("parameters.yaml"), dataset = input_dataset, group = input_group),
        "step02_params": expand(step02.path("parameters.yaml"), dataset = input_dataset, group = input_group),
        "step03_params": expand(step03.path("parameters.yaml"), dataset = input_dataset, group = input_group),
        "step04_params": expand(step04.path("parameters.yaml"), dataset = input_dataset, group = input_group),
        "step05_params": expand(step05.path("parameters.yaml"), dataset = input_dataset, group = input_group),
        "step06_params": expand(step06.path("parameters.yaml"), dataset = input_dataset, group = input_group),
        "step07_params": expand(step07.path("parameters.yaml"), dataset = input_dataset, group = input_group),
    }

    return sum(param_dict.values(), [])


