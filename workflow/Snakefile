# in particular regarding the standardized folder structure mentioned there.

# ── Timing helpers ────────────────────────────────────────────────────
import sys
import time
import os
from datetime import datetime

# Verbose load-time / timing instrumentation is gated on config["debug"].
# Default False; the real value is read once config/config.yaml is loaded.
DEBUG = False

def _now() -> str:
    """Return the current wall-clock time as ``HH:MM:SS``."""
    return datetime.now().strftime("%H:%M:%S")

def _log(msg: str) -> None:
    """Print a timestamped debug message to stderr."""
    if DEBUG and workflow.is_main_process:
        print(f"[{_now()}] {msg}", file=sys.stderr)

# ── Snakemake setup ───────────────────────────────────────────────────
_t = time.perf_counter()
from snakemake.utils import min_version
from snakemake.utils import validate
from snakemake.utils import logger
_utils_import_time = time.perf_counter() - _t

# Set the minimum snakemake version
min_version("9.23.0")
shell.prefix("set -euo pipefail; ")

