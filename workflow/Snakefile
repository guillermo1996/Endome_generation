# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.

# ── Snakemake setup ───────────────────────────────────────────────────
from snakemake.utils import min_version
from snakemake.utils import validate
from snakemake.utils import logger

## Set the minimum snakemake version
min_version("9.23.0")

## Set -euo pipefail
shell.prefix("set -euo pipefail; ")

# ── Configuration ─────────────────────────────────────────────────────
configfile: "config/presets.yaml"
configfile: "config/config.yaml"

## Validate configuration
# validate(config, schema="../schema/config_schema.yaml")

# ── Wildcard constraints ──────────────────────────────────────────────
wildcard_constraints:
    dataset = r"[^./]+",
    group = r"[^./]+",
    merge_method = r"(st|iso)(_[A-Za-z0-9_]+)?|ext",
    txEnd = r"\dp",
    sample_id = r"[^/]+",
    endome_name = r"[^/]+\.w[^./]+\.\dp",
    prefix = r"[^./]+\.[^./]+\.[^./]+", 
    
# ── Rule modules ──────────────────────────────────────────────────────
include: "rules/00-Common.smk"
include: "rules/01-Alignment.smk"
include: "rules/02-Transcriptome_Assembly.smk"
include: "rules/03-Artifact_Removal.smk"
include: "rules/04-ORF_Identification.smk"
include: "rules/05-Truncation.smk"
include: "rules/06-UTR_Quantification.smk"
include: "rules/07-UTR_Usage.smk"

# ── Lifecycle hooks ───────────────────────────────────────────────────
onstart:
    print("\n--- Analysis started ---\n")

onsuccess:
    print("\n--- Workflow finished! ---\n")

onerror:
    print("\n--- An error occurred! ---\n")


# ── Pipeline variables ────────────────────────────────────────────────
endome_table = build_endome_table(config.get("pipeline_defaults", {}), config["pipeline_inputs"])
endome_samples = load_endome_samples(endome_table, config.get("input_endome_samples"))

# ── Main outputs ──────────────────────────────────────────────────
endome_prefix = "{dataset}.{group}.{merge_method}"
endome_name = "{dataset}.{group}.{merge_method}.{orf_filter}.w{width}.{txEnd}"

endome_axes = table_axes("dataset", "group", "merge_method", "orf_filter", "width", "txEnd")
endome_axes_info = table_axes("dataset", "group", "merge_method", "orf_filter", "width", "txEnd", where = "has_orfs")
endome_axes_sce = table_axes("dataset", "group", "endome_name")
endome_axes_pseudobulk = table_axes("dataset", "group", "endome_name", "pseudobulk_method")
endome_axes_dtu = table_axes("dataset", "group", "endome_name", "pseudobulk_method", "saturn_method")

truncated_gtf = expand(step05.path("txendcutr/" + endome_name + ".txendcutr.gtf"), zip, **endome_axes)
info_report = expand(step05.path("characterization/reports/" + endome_name + ".html"), zip, **endome_axes_info)
endome_targets = expand(step06.path("Configs/{endome_name}.scUTRquant_config.yaml"), zip, **endome_axes_sce)
scUTRquant_sce = expand(rules.run_scUTRquant.output.sce, zip, **endome_axes_sce)
pseudobulk = expand(rules.pseudobulk_scUTRquant.output.pseudobulk, zip, **endome_axes_pseudobulk)
satuRn = expand(rules.satuRn_DTU.output.results, zip, **endome_axes_dtu)

rule all:
    input:
        parameters = generate_param_files(),
        truncated_gtf = truncated_gtf,
        info_report = info_report,
        scUTRquant_sce = scUTRquant_sce,
        pseudobulk = pseudobulk,
        satuRn = satuRn
    default_target: True

