################################################################################
## Endome Truncation
################################################################################

### The following rule was extracted and addapted from `txcutr-db` by Mayrlab: https://github.com/Mayrlab/txcutr-db
rule gtxcutr_truncation:
    input: 
        gtf = rules.sqanti3_rescue.output # "results/Sqanti3_Rescue/{prefix}_rescued.gtf"
    output: 
        gtf = "results/gtxcutr/{prefix}.gtxcutr.w{width}.gtf.gz",
        fa = "results/gtxcutr/{prefix}.gtxcutr.w{width}.fa.gz",
        tsv = "results/gtxcutr/{prefix}.gtxcutr.w{width}.merge.tsv"
    log: "logs/gtxcutr/{prefix}.gtxcutr.w{width}.log"
    benchmark: "benchmarks/gtxcutr/{prefix}.gtxcutr.w{width}.tsv"
    params:
        mergeDist = 200,
        genome = "hg38"
    conda: "envs/gtxcutr.yaml"
    threads: 20
    script: "scripts/gtxcutr.R" # Modified `txcutr.R` script to include my version of the package

rule kallisto_index:
    input:
        fa = rules.gtxcutr_truncation.output.fa
    output:
        kdx = "results/gtxcutr/{prefix}.gtxcutr.w{width}.kdx"
    log: "logs/kallisto/{prefix}.gtxcutr.w{width}.log"
    benchmark: "benchmarks/kallisto/{prefix}.gtxcutr.w{width}.tsv"
    conda: "envs/kallisto.yaml"
    threads: 8
    shell:
        "kallisto index --threads {threads} -i {output.kdx} {input.fa} > {log} 2>&1"