################################################################################
## Endome Truncation
################################################################################
filter_gtf_preTruncation = config["filter_gtf_preTruncation"]

def select_gtf_preTruncation(filter_gtf_preTruncation = "none", gtf_correction_method = "none"):
    if filter_gtf_preTruncation:
        return rules.orf_filtration.output.gtf
    else:
        return select_gtf_correction_input(gtf_correction_method)

### The following rule was extracted and addapted from `txcutr-db` by Mayrlab: https://github.com/Mayrlab/txcutr-db
rule gtxcutr_truncation:
    input: 
        gtf = select_gtf_preTruncation(filter_gtf_preTruncation)
    output: 
        gtf = results_path("05-Truncation/gtxcutr/{prefix}.gtxcutr.w{width}.{txEnd}.gtf"),
        fa = results_path("05-Truncation/gtxcutr/{prefix}.gtxcutr.w{width}.{txEnd}.fa.gz"),
        transcript_overlap = results_path("05-Truncation/gtxcutr/{prefix}.gtxcutr.w{width}.{txEnd}.overlaps.tsv"),
        merge_table = results_path("05-Truncation/gtxcutr/{prefix}.gtxcutr.w{width}.{txEnd}.merge.tsv")
    log: log_path("gtxcutr/{prefix}.gtxcutr.w{width}.{txEnd}.log")
    benchmark: benchmark_path("gtxcutr/{prefix}.gtxcutr.w{width}.{txEnd}.tsv")
    wildcard_constraints: 
        txEnd = "\\dp"
    params:
        mergeDist = 200,
        genome = "hg38"
    conda: "envs/gtxcutr.yaml"
    threads: 12
    script: "scripts/gtxcutr.R" # Modified `txcutr.R` script to include my version of the package

rule txcutr_truncation:
    input: 
        gtf = select_gtf_preTruncation(filter_gtf_preTruncation)
    output: 
        gtf = results_path("05-Truncation/txcutr/{prefix}.txcutr.w{width}.gtf"),
        fa = results_path("05-Truncation/txcutr/{prefix}.txcutr.w{width}.fa.gz"),
        tsv = results_path("05-Truncation/gtxcutr/{prefix}.gtxcutr.w{width}.merge.tsv")
    log: results_path("txcutr/{prefix}.txcutr.w{width}.log")
    benchmark: results_path("txcutr/{prefix}.txcutr.w{width}.tsv")
    params:
        mergeDist = 200,
        genome = "hg38"
    conda: "envs/txcutr.yaml"
    threads: 24
    script: "scripts/txcutr.R"


################################################################################
## Endome Annotation
################################################################################

rule endome_annotation:
    input:
        gtf = rules.gtxcutr_truncation.output.gtf
    output:
        gtf = "results/Endome_Annotation/{prefix}.w{width}.annotated.gtf"
    log: "outputs/logs/Endome_Annotation/{prefix}.gtxcutr.w{width}.log"
    benchmark: "outputs/benchmarks/Endome_Annotation/{prefix}.gtxcutr.w{width}.tsv"
    conda: "envs/r_scripts.yaml"
    script: "scripts/Endome_Annotation.R"

################################################################################
## scUTRquant pseudo-alignment
################################################################################
samples = pd.read_csv(config['sample_file'], index_col='sample_id')

def get_sequence_files(wildcards):
    return samples.files[wildcards.sample_id].split(';')

rule kallisto_index:
    input:
        fa = rules.gtxcutr_truncation.output.fa
    output:
        kdx = results_path("06-Evaluation/gtxcutr/{prefix}.gtxcutr.w{width}.{txEnd}.kdx")
    log: log_path("kallisto/{prefix}.gtxcutr.w{width}.{txEnd}.log")
    benchmark: benchmark_path("kallisto/{prefix}.gtxcutr.w{width}.{txEnd}.tsv")
    params:
        tmp_dir = "tmp_kallisto_{prefix}_{width}_{txEnd}"
    conda: "envs/kallisto.yaml"
    threads: 8
    shell:
        # "kallisto index --threads {threads} --tmp {params.tmp_dir} -i {output.kdx} {input.fa} > {log} 2>&1"
        "kallisto index -i {output.kdx} {input.fa} 2>&1 | tee {log}"

rule kallisto_bus:
    input:
        kdx = rules.kallisto_index.output.kdx,
        files = get_sequence_files
    output:
        run_info = results_path("06-Evaluation/kallisto/{prefix}.w{width}.{txEnd}/{sample_id}/run_info.json"),
    params:
        tech = config["tech"],
        strand = config["strand"],
        out_dir = results_path("06-Evaluation/kallisto/{prefix}.w{width}.{txEnd}/{sample_id}")
    log: log_path("kallisto/{prefix}.w{width}.{txEnd}/{sample_id}.log")
    benchmark: benchmark_path("kallisto/{prefix}.w{width}.{txEnd}/{sample_id}.tsv")
    conda: "envs/kallisto.yaml"
    wildcard_constraints: 
        runThreads = "\\d+"
    threads: 16
    shell:
        """
        kallisto bus -t {threads} -i {input.kdx} -x {params.tech} {params.strand} -o {params.out_dir} --verbose {input.files} 2>&1 | tee {log}
        """
        
rule pseudoalignment_rate:
    input:
        input_dir = results_path("06-Evaluation/kallisto/{prefix}.w{width}.{txEnd}")
        # input_files = expand(results_path("06-Evaluation/kallisto/{{prefix}}.w{{width}}.{{txEnd}}/{sample_id}/run_info.json"), sample_id = samples.index.values)
    output:
        png = results_path("figures/{prefix}.w{width}.{txEnd}.pseudoalignment_rate.png")
    conda: "envs/r.yaml"
    script: "scripts/merge_run_info.R"

