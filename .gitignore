# ==============================================================================
# ENDome pipeline: .gitignore
# ==============================================================================

# ---- Pipeline outputs --------------------------------------------------------
/results/
/debug_results/
/resources/
slurm-*.out
nohup.out

# ---- Tools fetched at runtime ------------------------------------------------
/tools/

# ---- Local input data --------------------------------------------------------
/data/

# ---- Snakemake or enviroments ------------------------------------------------
.snakemake/
.pixi/*
!.pixi/config.toml
__pycache__/
*.pyc

# ---- Deprecated and experimental code ----------------------------------------
**/deprecated/
workflow/rules/test*_*.smk
workflow/rules/*_ALT.smk
*copy.*

# ---- R / RMarkdown byproducts -------------------------------------------------
.Rhistory
.RData
.Rproj.user/
*.Rproj
Rplots.pdf
*_files/
*_cache/
workflow/scripts/*.html

# ---- Local development (not part of the published pipeline) -------------------
/claude_tmp/
/.claude/
/test/
/workflow/scripts/tests
/docs/satuRn
/docs/*.md
*.gpg
*.code-workspace
.vscode/
.idea/

# ---- OS / editor ---------------------------------------------------------------
.DS_Store
*~
*.swp