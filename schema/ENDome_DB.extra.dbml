// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------
TableGroup "ENDome core" [color: #1F77B4] {
  bins
  transcripts
  cds
  proteins
  utr5
  utr3
}

TableGroup "Bin Information Content" [color: #9467BD] {
  bin_information
}

TableGroup "Transient (not persisted)" [color: #C0392B] {
  protein_pairs
  bin_pairs_distance
}

TableGroup "Provenance (proposed)" [color: #6C6C6C] {
  runs
}
